# API Torznab compatible. Exemple Jackett/Prowlarr complet :
# C411_API_URL=https://c411.org/api
C411_API_URL=https://c411.org/api

# Ne mets jamais cette valeur dans le code.
C411_API_KEY=remplace_moi

# Port du serveur RSS/API local.
SERVER_PORT=4174

# Filtres par defaut, modifiables depuis l'URL RSS.
MAX_SEEDERS=30
MIN_LEECHERS=2
MIN_SIZE_GB=1
MAX_SIZE_GB=500
MAX_AGE_HOURS=6
MIN_SCORE=0
MAX_RESULTS=40

# Nombre minimal de resultats API a scanner avant classement global.
# Plus haut = meilleurs classements, mais plus lent.
SCAN_RESULTS=800
