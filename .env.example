# Ce projet est prévu pour Cloudflare Workers + D1.
# Les clés API C411 sont saisies par les utilisateurs sur la page de connexion.
C411_API_URL=https://c411.org/api

# Filtres par défaut, modifiables depuis l'interface et l'URL RSS.
MAX_SEEDERS=30
MIN_LEECHERS=2
MIN_SIZE_GB=1
MAX_SIZE_GB=500
MAX_AGE_HOURS=6
MIN_SCORE=0
MAX_RESULTS=40

# Nombre minimal de résultats API à scanner avant classement global.
SCAN_RESULTS=800
D1_CACHE_TTL_SECONDS=900

# À configurer en secrets Cloudflare, pas en variables publiques :
# SESSION_SECRET
# ENCRYPTION_SECRET
